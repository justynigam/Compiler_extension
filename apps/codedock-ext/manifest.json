{
  "manifest_version": 3,
  "name": "CodeDock",
  "version": "1.0.0",
  "description": "A lightweight multi-language compiler in your browser sidebar",
  "permissions": ["sidePanel", "storage"],
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "CodeDock"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}